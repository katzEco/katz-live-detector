# Server port
PORT=3030

# PostgreSQL connection (default port 5431 for postgres_katz_eco)
DATABASE_URL=postgres://dethz:dethz198@localhost:5431/app

# Redis connection (default port 6380 for redis_katz_eco)
REDIS_URL=redis://localhost:6380

# Default n8n Webhook URL (triggered when creator goes LIVE or stream ends)
# Example: https://n8n.yourdomain.com/webhook/tiktok-live
N8N_DEFAULT_WEBHOOK_URL=

# Default checking interval in seconds (minimum 10s)
CHECK_INTERVAL_SECONDS=60

# Optional initial creators to monitor on startup (comma-separated, without @)
# Example: khaby.lame,mrbeast
INITIAL_USERNAMES=

# Optional API key to protect /api/* routes (leave empty to disable authentication)
API_KEY=

# Optional secret sent in 'X-Webhook-Secret' header to n8n for verification
WEBHOOK_SECRET=
